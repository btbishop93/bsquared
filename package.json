{
  "name": "bsquared",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:ssh": "bun --cwd apps/ssh dev",
    "dev:web": "bun --cwd apps/web dev",
    "build": "bun --filter '*' run build",
    "resume:check": "bun run scripts/check-resume-sync.ts",
    "resume:build": "cd data/resume && tectonic resume.tex && cp resume.pdf ../../apps/web/public/resume.pdf",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "shadcn": "^3.6.2",
    "typescript": "^5.3.0"
  }
}
